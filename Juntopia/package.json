{
  "name": "juntopia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @juntopia/frontend",
    "build": "npm run build --workspace @juntopia/frontend",
    "preview": "npm run preview --workspace @juntopia/frontend",
    "lint": "npm run lint --workspaces",
    "test": "npm test --workspace @juntopia/frontend",
    "test:render": "npm run test:render --workspace @juntopia/frontend",
    "check:backend": "npm run check --workspace @juntopia/backend",
    "format": "prettier --write frontend/src frontend/tests backend/scripts backend/tests"
  },
  "devDependencies": {
    "prettier": "3.10.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
