VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=/api
# Optional explicit return address; it must also be allowed in Supabase Auth.
VITE_AUTH_REDIRECT_URL=http://localhost:3000/
# Local testing: each new load starts at registration without a saved session.
# Set true to remember the session between visits.
VITE_AUTH_PERSIST_SESSION=false
